pipeline {
    agent any

    environment {
        VENV_NAME = 'venv'
        DOCKER_COMPOSE_VERSION = 'v2.23.0'
    }

    stages {
        stage('Install Docker Compose') {
            steps {
                sh '''
                    # Install Docker Compose as Docker CLI plugin (no sudo needed)
                    if ! docker compose version >/dev/null 2>&1; then
                        echo "Installing Docker Compose..."
                        mkdir -p ~/.docker/cli-plugins/
                        curl -SL "https://github.com/docker/compose/releases/download/${DOCKER_COMPOSE_VERSION}/docker-compose-$(uname -s)-$(uname -m)" \
                            -o ~/.docker/cli-plugins/docker-compose
                        chmod +x ~/.docker/cli-plugins/docker-compose
                    else
                        echo "Docker Compose is already installed."
                    fi
                    
                    # Verify installation
                    docker compose version || exit 1
                '''
            }
        }

        stage('Checkout Code') {
            steps {
                git url: 'https://github.com/Aryangupta6612/django-todo-cicd.git', branch: 'develop'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t todo-app-cicd .'
            }
        }

        stage('Run Tests') {
            steps {
                sh 'docker run --rm todo-app-cicd python manage.py test'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker compose down || true
                    docker compose up -d --build
                    echo "Waiting for application to start..."
                    sleep 15
                    curl --fail http://localhost:8000 || exit 1
                '''
            }
        }
    }

    post {
        always {
            sh 'docker container prune -f || true'
            sh 'docker image prune -f || true'
        }
        success {
            echo '✅ Build and deployment successful!'
        }
        failure {
            echo '❌ Build failed. Please check the logs!'
        }
    }
}